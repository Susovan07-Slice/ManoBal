# =============================================================================
# ManoBal System - Docker Compose Environment Configuration
# =============================================================================
# Instructions: Copy this file to .env and adjust variables as needed.
# NEVER commit the actual .env file with real secrets to version control.
# =============================================================================

# PostgreSQL Container Configuration
POSTGRES_DB=stress_monitoring
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-secure-development-password

# FastAPI Backend Configuration
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
LOG_LEVEL=INFO

# Frontend Client Configuration
# Browser-facing backend API endpoint (accessed by the user's browser via host port)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
